<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Version.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1573;1587</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>UniversalInput.Contracts</PackageId>
    <Version>$(UniversalInputVersion)</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Authors>Roland Rusiecki</Authors>
    <Copyright>Copyright (c) 2026 Roland Rusiecki</Copyright>
    <Description>Platform-agnostic input and event contracts extracted from PhialeGis UniversalEvents.</Description>
    <PackageTags>input;contracts;events;cross-platform;dto</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)bin/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Link="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE.txt" Link="LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
  </ItemGroup>
</Project>
